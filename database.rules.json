{
  "rules": {
    ".read": false,
    ".write": false,
    "roles": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('roles').child(auth.uid).val() === 'admin')",
        ".write": "auth != null && root.child('roles').child(auth.uid).val() === 'admin'",
        ".validate": "newData.val() === 'admin' || newData.val() === 'viewer'"
      }
    },
    "events": {
      "$eventId": {
        ".read": "auth != null && (root.child('roles').child(auth.uid).val() === 'admin' || root.child('roles').child(auth.uid).val() === 'viewer')",
        ".write": "auth != null && root.child('roles').child(auth.uid).val() === 'admin'"
      }
    }
  }
}
